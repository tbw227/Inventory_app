{
  "name": "inventory_app",
  "version": "1.0.0",
  "description": "manage inventory",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbw227"
  },
  "license": "ISC",
  "author": "Tim Withrow",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "npm test --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "monitoring:up": "docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker compose -f docker-compose.yml -f docker-compose.monitoring.yml down",
    "dev:mobile": "npm run dev:all",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status"
  },
  "dependencies": {
    "axios": "^1.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
