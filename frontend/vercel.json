{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://inventoryapp-production-dfa1.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
