# Vercel (frontend only — set Root Directory to `frontend` in the Vercel project)
# Required for Production: your Railway API origin — no /api/v1 suffix
# Example: https://inventoryapp-production-dfa1.up.railway.app
VITE_API_URL=
# Stripe.js (Job Detail card payments). Use pk_test_… for local HTTP; pk_live_… needs HTTPS (except localhost).
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Supabase (Project Settings → API). Optional until you use Supabase client features.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: override Vite dev server port (default 5174 in vite.config)
# VITE_DEV_PORT=5174
# HTTPS for Vite (mobile camera testing). Default off — use http://localhost:5174 locally.
# VITE_DEV_HTTPS=false
# SaaS product name (shell UI) — not client/tenant names
# VITE_PRODUCT_NAME=FieldOps
# VITE_LOGO_URL=/logo.svg
# App portal URL (for marketing site "Sign in" links). Production example:
# VITE_APP_URL=https://inventory-app-delta-seven.vercel.app
# Marketing site — discovery only; sign-in always goes to the app portal (/sign-in or /login)
VITE_MARKETING_URL=http://localhost:5175
# In-app signup at /register (beta). Requires Railway ALLOW_PUBLIC_REGISTRATION=true.
# Set false once marketing site /signup is live.
VITE_ALLOW_PUBLIC_REGISTRATION=true

# Clerk sign-in (replaces password login when set). Get keys from Clerk Dashboard → API keys.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
