{
  "name": "firetrack-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npx prisma migrate deploy && node server.js",
    "dev": "node server.js",
    "seed": "node seed.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/express": "^1.7.81",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.47.0",
    "@supabase/supabase-js": "^2.108.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.0.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.13.0",
    "prisma": "^6.19.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "inflight": "npm:empty-npm-package@*",
